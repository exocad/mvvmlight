<Project>
	<PropertyGroup>
		<Copyright>Copyright © exocad GmbH 2020-2026 GalaSoft Laurent Bugnion 2009-2018</Copyright>
		<Company>exocad GmbH based on work of GalaSoft Laurent Bugnion @ http://www.galasoft.ch</Company>
		<Version>5.4.2.0</Version>

		<TargetFrameworks>net6.0-windows;net8.0-windows;net10.0-windows</TargetFrameworks>
	</PropertyGroup>

	<PropertyGroup>
		<UseArtifactsOutput>true</UseArtifactsOutput>
		<PackageProjectUrl>https://github.com/exocad/mvvmlight</PackageProjectUrl>
		<RepositoryUrl>https://github.com/exocad/mvvmlight</RepositoryUrl>
		<PackageReadMeFile>README.md</PackageReadMeFile>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
	</PropertyGroup>

	<ItemGroup>
		<SupportedOSPlatform Include="windows" />
	</ItemGroup>
</Project>
